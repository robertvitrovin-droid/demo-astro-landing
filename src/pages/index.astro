---
const services = [
  { t: 'Швидка діагностика', p: 'безкоштовно', d: 'Огляд за 15 хвилин: гальма, перемикачі, колеса. Кажемо чесно, що варто робити, а що почекає.' },
  { t: 'Базове ТО', p: 'від 450 грн', d: 'Чистка й мастило ланцюга, налаштування гальм і перемикачів, підкачка, перевірка болтів.' },
  { t: 'Повне ТО', p: 'від 1 100 грн', d: 'Розбирання, мийка трансмісії, обслуговування втулок і рульової, центрування коліс.' },
  { t: 'Ремонт коліс', p: 'від 150 грн', d: 'Заміна камери чи покришки, переспицювання, центрування «вісімки».' },
  { t: 'Гідравлічні гальма', p: 'від 350 грн', d: 'Прокачка, заміна колодок і роторів, усунення скрипу.' },
  { t: 'Зберігання на зиму', p: 'від 300 грн/міс', d: 'Сухе опалюване приміщення і ТО перед сезоном зі знижкою.' },
];
const steps = [
  ['Запишіться', 'Подзвоніть або напишіть у Telegram, оберіть зручний час.'],
  ['Привезіть велосипед', 'Безкоштовно діагностуємо й узгоджуємо ціну до початку робіт.'],
  ['Заберіть готовий', 'Більшість робіт за 1 день. Повідомимо, щойно все буде готово.'],
];
const faq = [
  ['Чи можна дочекатися на місці?', 'Так, дрібний ремонт (камера, налаштування гальм) зазвичай займає 20–40 хвилин.'],
  ['Працюєте з електровелосипедами?', 'Механіку — так: гальма, трансмісія, колеса. Електроніку не ремонтуємо.'],
  ['Чи даєте гарантію?', 'На роботи 30 днів. Якщо щось налаштоване неправильно, виправимо безкоштовно.'],
];
const base = import.meta.env.BASE_URL;
const title = 'Велосервіс «Спиця» — ремонт і ТО велосипедів (демо)';
const desc = 'Демо-лендинг вигаданого велосервісу: безкоштовна діагностика, ТО від 450 грн, ремонт за 1 день.';
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={desc} />
  <link rel="canonical" href="https://robertvitrovin-droid.github.io/demo-astro-landing/" /><link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:type" content="website" />
  <meta name="theme-color" content="#0f1626" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BicycleStore', name: 'Велосервіс «Спиця» (демо)', description: desc, priceRange: '₴₴' })} />
</head>
<body>
  <a class="skip" href="#main">Перейти до змісту</a>
  <div class="demo-bar" role="note">DEMO · вигаданий бізнес для портфоліо, контакти не справжні</div>
  <header class="top">
    <div class="wrap nav">
      <a href={base} class="logo" aria-label="Спиця, на головну">
        <svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#e8a33d"/><circle cx="10" cy="20" r="6" fill="none" stroke="#0f1626" stroke-width="2.5"/><circle cx="22" cy="20" r="6" fill="none" stroke="#0f1626" stroke-width="2.5"/></svg>
        <span>Спиця</span></a>
      <nav aria-label="Основна навігація"><ul>
        <li><a href="#services">Послуги</a></li><li><a href="#how">Як працюємо</a></li><li><a href="#faq">Питання</a></li><li><a class="btn sm" href="#contact">Записатися</a></li>
      </ul></nav>
    </div>
  </header>
  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">Велосервіс у центрі міста</p>
          <h1>Ваш велосипед знову їде тихо і гальмує впевнено</h1>
          <p class="lead">Безкоштовна діагностика, чесна ціна до початку робіт і ремонт здебільшого за один день.</p>
          <div class="cta"><a class="btn" href="#contact">Записатися на діагностику</a><a class="btn ghost" href="#services">Ціни на послуги</a></div>
          <ul class="facts" aria-label="Переваги"><li><b>1 день</b>типовий ремонт</li><li><b>30 днів</b>гарантія на роботи</li><li><b>0 грн</b>діагностика</li></ul>
        </div>
        <svg class="art" viewBox="0 0 400 300" role="img" aria-label="Ілюстрація велосипеда">
          <circle cx="200" cy="150" r="140" fill="#17213a"/>
          <g fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="115" cy="190" r="58" stroke="#e8a33d"/><circle cx="285" cy="190" r="58" stroke="#e8a33d"/>
            <path d="M115 190l60-90h85l25 90M175 100l40 90h70M215 190l-40-90" stroke="#fff"/>
            <path d="M160 85h35M250 80l12 20" stroke="#8fb3d6"/>
          </g>
          <g stroke="#e8a33d" stroke-width="2" opacity=".6"><path d="M115 132v116M57 190h116M285 132v116M227 190h116"/></g>
        </svg>
      </div>
    </section>
    <section id="services" class="wrap sec" aria-labelledby="s-h">
      <h2 id="s-h">Послуги та ціни</h2>
      <p class="sub">Фінальну вартість узгоджуємо після діагностики. Запчастини оплачуються окремо.</p>
      <ul class="cards">{services.map(s => <li class="card"><h3>{s.t}</h3><p class="price">{s.p}</p><p>{s.d}</p></li>)}</ul>
    </section>
    <section id="how" class="band" aria-labelledby="h-h">
      <div class="wrap sec"><h2 id="h-h">Як ми працюємо</h2>
        <ol class="steps">{steps.map(([t, d], i) => <li><span class="n" aria-hidden="true">{i + 1}</span><h3>{t}</h3><p>{d}</p></li>)}</ol></div>
    </section>
    <section id="faq" class="wrap sec" aria-labelledby="f-h">
      <h2 id="f-h">Часті питання</h2>
      {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
    <section id="contact" class="band" aria-labelledby="c-h">
      <div class="wrap sec contact"><div><h2 id="c-h">Записатися</h2>
        <p>Пн–Сб, 10:00–19:00. Відповідаємо протягом години в робочий час.</p>
        <p class="note">Це демо-сторінка: контакти нижче не ведуть до реального бізнесу.</p></div>
        <div class="cta"><a class="btn" href="tel:+380000000000">Подзвонити: +380 00 000 00 00</a><a class="btn ghost" href="https://t.me/" rel="noopener">Написати в Telegram</a></div>
      </div>
    </section>
  </main>
  <footer class="wrap foot"><p>© 2026 «Спиця» — вигаданий велосервіс. Демо-лендинг для портфоліо, Astro.</p></footer>
</body>
</html>
<style is:global>
:root{--bg:#fbfaf7;--ink:#141b2b;--muted:#4a5568;--navy:#0f1626;--acc:#e8a33d;--acc-ink:#7a4a00;--line:#e4e1d8}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;font:17px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--bg)}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:#fff;padding:10px 14px;z-index:9;border-radius:8px}
.demo-bar{background:var(--acc);color:#111;text-align:center;font-size:14px;font-weight:700;padding:6px 10px;letter-spacing:.5px}
.top{background:var(--navy);color:#fff;position:sticky;top:0;z-index:5}
.nav{display:flex;align-items:center;justify-content:space-between;min-height:64px;gap:12px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:10px;color:#fff;text-decoration:none;font-weight:800;font-size:20px}
nav ul{display:flex;gap:6px;list-style:none;margin:0;padding:0;flex-wrap:wrap}
nav a{color:#e6edf6;text-decoration:none;padding:10px 12px;border-radius:8px;display:inline-block;min-height:44px}
nav a:hover{background:#ffffff14}
a:focus-visible,summary:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;border-radius:12px;background:var(--acc);color:#111!important;font-weight:700;text-decoration:none}
.btn.sm{min-height:44px;padding:10px 16px}.btn.ghost{background:transparent;color:inherit!important;border:2px solid currentColor}
.hero{background:var(--navy);color:#fff;padding:56px 0 72px}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
.eyebrow{color:#ffd28a;font-weight:700;text-transform:uppercase;letter-spacing:1px;font-size:14px;margin:0}
h1{font-size:clamp(32px,5vw,54px);line-height:1.1;margin:12px 0 16px}
.lead{font-size:20px;color:#d5deea;max-width:34em}.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.facts{display:flex;gap:28px;list-style:none;padding:0;margin:32px 0 0;flex-wrap:wrap;color:#c9d4e2}.facts b{display:block;font-size:26px;color:#fff}
.art{width:100%;height:auto}
.sec{padding:64px 20px}h2{font-size:clamp(26px,3.4vw,38px);margin:0 0 8px}.sub{color:var(--muted);margin:0 0 28px}
.cards{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px}
.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px}.card h3{margin:0 0 4px;font-size:20px}
.price{color:var(--acc-ink);font-weight:800;margin:0 0 8px}.card p:last-child{margin:0;color:var(--muted)}
.band{background:#f1eee6}
.steps{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin:24px 0 0}
.steps .n{display:inline-flex;width:44px;height:44px;border-radius:50%;background:var(--navy);color:#fff;align-items:center;justify-content:center;font-weight:800}
.steps h3{margin:12px 0 4px}.steps p{margin:0;color:var(--muted)}
details{background:#fff;border:1px solid var(--line);border-radius:12px;padding:4px 18px;margin:10px 0}
summary{cursor:pointer;font-weight:700;padding:12px 0;min-height:44px}
.contact{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}.note{font-size:15px;color:var(--muted)}
.foot{padding:28px 20px;color:var(--muted);font-size:15px}
@media (max-width:800px){.hero-grid{grid-template-columns:1fr}.art{max-width:320px;margin:0 auto}.steps{grid-template-columns:1fr}.hero{padding:36px 0 48px}nav ul li:not(:last-child){display:none}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
